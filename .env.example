# ==============================================================
# Telegram Drive Access Bot Configuration
# ==============================================================

# 1. Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=9282256059:AAEqU5jBUnzBoidaqyhu-x-WCxI4_0eFyXU

# 2. Your personal Telegram User ID (Optional, highly recommended)
# The bot will send you real-time audit notifications whenever someone
# requests or downloads a file while you are offline.
# (You can find your user ID by messaging @userinfobot on Telegram)
ADMIN_TELEGRAM_ID=

# 3. Google Drive Scope / Folder Restriction
# Paste the Google Drive Folder ID to restrict file browsing to a specific folder.
# Example: If your URL is drive.google.com/drive/folders/1a2B3c4D5e6F7g
# Then folder ID is: 1a2B3c4D5e6F7g
# If left blank, the bot will search all files accessible by its credentials.
GOOGLE_DRIVE_FOLDER_ID=1RUFiaPLkqqS_um1tv0zwL93-ClZS-2BD

# 4. Access Security & Passcode (Optional)
# If set, users must send: /auth <passcode> before they can browse or get files.
ACCESS_PASSCODE=

# Comma-separated list of allowed Telegram user IDs or usernames (without @)
# Example: 12345678,98765432,alice,bob
# If left blank, anyone who knows the passcode (or anyone if passcode is blank) can request.
ALLOWED_TELEGRAM_USERS=

# Comma-separated list of approved Google / Gmail accounts allowed to receive file access
# If set, ONLY these emails can receive Google Drive access. If blank, any valid email is accepted.
# Example: friend1@gmail.com,colleague@gmail.com
ALLOWED_EMAILS=

# Comma-separated list of allowed Topic/Thread IDs in Telegram forum supergroups
# If set, the bot will strictly and ONLY respond inside these topics/sections.
# Example: ALLOWED_TOPIC_IDS=1949
ALLOWED_TOPIC_IDS=

# 5. Permission & Access Options
# Default Google Drive role granted when sharing with requester's email: 'reader' (Viewer) or 'commenter'
DEFAULT_SHARE_ROLE=reader

# Allow downloading files <= 50MB directly in Telegram (true/false)
ENABLE_DIRECT_DOWNLOAD=true

# Allow sharing files directly to requester's Google email (true/false)
ENABLE_EMAIL_SHARING=true

# Credentials file paths (defaults to root directory)
SERVICE_ACCOUNT_FILE=service_account.json
OAUTH_CREDENTIALS_FILE=credentials.json
OAUTH_TOKEN_FILE=token.json
